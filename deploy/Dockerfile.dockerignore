# Secrets — pass via env_file / -e, never bake into the image
.env

# Virtualenvs
myenv.nosync/
**/myenv*/
.venv/

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local-only generated data (re-seeded / re-created in the container)
data/vector_store/
data/checkpoints.db
data/checkpoints.db-shm
data/checkpoints.db-wal
logs/
outputs/

# VCS & tooling
.git/
.github/
.cursor/
.codex/
.vscode/
.DS_Store
**/.DS_Store

# Docs / reports not needed at runtime
report/
instructions/
assets/
*.md
