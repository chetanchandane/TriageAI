# Build-context excludes for the root Dockerfile (Hugging Face / Render / Compose).

# Secrets — pass via Space settings / env_file / -e, never bake into the image
.env

# Virtualenvs
myenv.nosync/
**/myenv*/
.venv/

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local-only generated data (re-seeded / re-created in the container)
data/vector_store/
data/checkpoints.db
data/checkpoints.db-shm
data/checkpoints.db-wal
logs/
outputs/

# VCS & tooling
.git/
.github/
.cursor/
.codex/
.vscode/
.DS_Store
**/.DS_Store

# Docs / reports not needed at runtime.
# NOTE: *.md is root-scoped (Docker's * does not cross '/'), so it drops
# README.md/DEVELOPMENT.md/etc. but NOT data/policies/*.md. The re-include
# below guarantees the policy corpus is always baked in regardless.
report/
instructions/
assets/
*.md

# Never exclude the policy corpus — it's seeded into ChromaDB at container boot.
!data/policies/
