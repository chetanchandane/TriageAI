# LLM (required for triage)
LLM_GEMINI_API_KEY=your_gemini_api_key
# Model name — change here to switch all LLM calls at once
LLM_MODEL=gemini-2.5-pro

# Supabase (optional; if not set, app runs in demo mode with in-memory auth and messages)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Optional: service role key so Staff view can load all patients' messages (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Persistent HITL checkpoints (LangGraph PostgresSaver). If unset, falls back to
# the local SqliteSaver at data/checkpoints.db. For Docker, point this at your
# Supabase Postgres — copy the URI from Supabase: Project Settings → Database →
# Connection string → URI, replace [YOUR-PASSWORD], and append ?sslmode=require.
# Use the connection pooler (host ...pooler.supabase.com, port 6543) if running
# more than one replica; use the direct connection (port 5432) for a single one.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?sslmode=require

# Email via Resend (optional; if not set, emails are printed to console as mock)
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key
# Optional: verified sender address (defaults to onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=TriageAI <triage@yourdomain.com>

# LangSmith tracing (optional; traces appear at smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=TriageAI
# LANGSMITH_API_KEY is also required for the offline eval suite (scripts/*_langsmith_*.py).
# LANGSMITH_DATASET names the offline eval dataset uploaded to LangSmith.
# LANGSMITH_DATASET=TriageAI-offline
# ONLINE evals: LANGSMITH_TRACING=true + LANGSMITH_API_KEY also enable live staff-feedback
# capture (graph/workflow.py) and let scripts/online_evaluators.py be attached as automations
# on LANGSMITH_PROJECT. With tracing off, both no-op (demo mode still runs on the Gemini key).
# LangChain aliases (langchain_core reads these)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=TriageAI
